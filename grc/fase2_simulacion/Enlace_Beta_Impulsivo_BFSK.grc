    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"PSD BFSK (fs = 256 kS/s, FFT 4096)"'
    nconnections: '2'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
