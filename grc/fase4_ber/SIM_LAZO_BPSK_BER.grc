options:
  parameters:
    author: Luis Arley Martinez Caballero - Johan Sebastian Gomez Hernandez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Tx BPSK + canal con CFO, desfase y error de reloj + e_EbN0_Sweep + receptor identico al de hardware + e_BER_Curve.
