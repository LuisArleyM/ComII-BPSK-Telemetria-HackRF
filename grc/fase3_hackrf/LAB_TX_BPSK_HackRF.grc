options:
  parameters:
    author: Luis Arley Martinez Caballero - Johan Sebastian Gomez Hernandez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Transmisor BPSK con secuencia conocida PRBS-15. 64 kS/s -> 2 MS/s. Solo RF confinada o frecuencia autorizada.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: LAB_TX_BPSK_HackRF
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LAB TX BPSK HackRF - PRBS-15 + RRC (8 kbaud, 2 MS/s)
    window_size: (1500,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8.0
    rotation: 0
    state: enabled
blocks:
- name: Rs
  id: variable
  parameters:
    comment: 'Tasa de simbolos: 8 kbaud'
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 8.0
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 290
    - 8.0
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: bb_rate = 64 kS/s
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 370
    - 8.0
    rotation: 0
    state: enabled
- name: tabla_bpsk
  id: variable
  parameters:
    comment: 'Mapeo del escenario S1: (-1+0j, 1+0j)'
    value: (-1+0j, 1+0j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 8.0
    rotation: 0
    state: enabled
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_bpsk)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 8.0
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 8.0
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: 'BPSK: Rb = Rs = 8 kb/s'
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 8.0
    rotation: 0
    state: enabled
- name: span
