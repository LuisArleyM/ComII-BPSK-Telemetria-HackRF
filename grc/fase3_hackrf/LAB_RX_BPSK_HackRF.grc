options:
  parameters:
    author: Luis Arley Martinez Caballero - Johan Sebastian Gomez Hernandez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Receptor BPSK: 2 MS/s -> 64 kS/s, AGC, FLL, PFB clock sync, Costas, decision, referencia PRBS-15 alineada.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: LAB_RX_BPSK_HackRF
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: LAB RX BPSK HackRF - sincronia + BER en condicion limpia
    window_size: (1500,950)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8.0
    rotation: 0
    state: enabled
blocks:
- name: Rs
  id: variable
  parameters:
    comment: Tasa de simbolos (igual al Tx)
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 8.0
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 290
    - 8.0
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: bb_rate = 64 kS/s
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 370
    - 8.0
    rotation: 0
    state: enabled
- name: tabla_bpsk
  id: variable
  parameters:
    comment: 'Mapeo BPSK del escenario: bit0 -> -1, bit1 -> +1'
    value: (-1+0j, 1+0j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 8.0
    rotation: 0
    state: enabled
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_bpsk)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 8.0
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 8.0
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: 'BPSK: Rb = Rs = 8 kb/s'
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 800
    - 8.0
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters:
    comment: ''
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 880
    - 8.0
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 8.0
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable
  parameters:
    comment: 'Lazo de Costas: 2pi/200 (elegido en el estudio de lazos)'
    value: 2*math.pi/200
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 8.0
    rotation: 0
    state: enabled
- name: fll_bw
  id: variable
  parameters:
    comment: 'FLL: 2pi/2500 (elegido en el estudio de lazos)'
    value: 2*math.pi/2500
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1040
    - 90.0
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: Frecuencia RF asignada (enlace confinado/autorizado)
    value: 960e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 90.0
    rotation: 0
    state: enabled
- name: lo_off
  id: variable
  parameters:
    comment: LO desplazado 200 kHz para sacar la senal del pico DC del HackRF
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 290
    - 90.0
    rotation: 0
    state: enabled
- name: radio_rate
  id: variable
  parameters:
    comment: Tasa del HackRF (>= 2 MS/s)
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 380
    - 90.0
    rotation: 0
    state: enabled
- name: hackrf_rx
  id: variable
  parameters:
    comment: ''
    value: '"hackrf=0"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 90.0
    rotation: 0
    state: enabled
- name: prbs_seed
  id: variable
  parameters:
    comment: Semilla PRBS-15 (igual en Tx y Rx)
    value: '32767'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 580
    - 90.0
    rotation: 0
    state: enabled
- name: const_bpsk
  id: variable_constellation
  parameters:
    comment: ''
    const_points: tabla_bpsk
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 8.0
    rotation: 0
    state: enabled
- name: beta
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Roll-off beta (igual al Tx)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.1'
    step: '0.05'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 8.0
    rotation: 0
    state: enabled
- name: rx_lna
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Rx IF gain / LNA HackRF (0-40 dB, pasos de 8)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '8'
    stop: '40'
    value: '16'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 110.0
    rotation: 0
    state: enabled
- name: rx_vga
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Rx BB gain / VGA HackRF (0-62 dB, pasos de 2)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '2'
    stop: '62'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1500
    - 110.0
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 120.0
    rotation: 0
    state: enabled
