- name: rx_desplaza
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: -lo_off
    comment: Trae la senal de -200 kHz a 0 Hz (compensa el LO desplazado)
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: radio_rate
    taps: '[1]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 260
    - 300.0
    rotation: 0
    state: enabled
- name: rx_resampler
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Adaptacion de tasa: 2 MS/s x 4/125 = 64 kS/s = bb_rate'
    decim: '125'
    fbw: '0'
    interp: '4'
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 480
    - 300.0
    rotation: 0
    state: enabled
- name: agc_entrada
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'AGC1: normaliza el nivel de entrada (cambia con la ganancia RF y con el AWGN del barrido)'
    gain: '1.0'
    max_gain: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 1e-3
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 700
    - 300.0
    rotation: 0
    state: enabled
- name: fll
  id: digital_fll_band_edge_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'FLL de borde de banda: corrige el offset de frecuencia Tx-Rx (cristales distintos)'
    filter_size: '44'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: beta
    samps_per_sym: Sps
    type: cc
    w: fll_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 900
    - 300.0
    rotation: 0
    state: enabled
- name: pfb_sync
  id: digital_pfb_clock_sync_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Filtro acoplado RRC (banco polifasico) + recuperacion de reloj: 1 muestra/simbolo'
    filter_size: nfilts
    init_phase: nfilts/2
    loop_bw: 2*math.pi/100
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    osps: '1'
    sps: Sps
    taps: firdes.root_raised_cosine(nfilts, nfilts*Sps, 1.0, beta, span*Sps*nfilts)
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 300.0
    rotation: 0
    state: enabled
- name: agc_simbolos
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'AGC2: amplitud de simbolo ~1 para que la ganancia del lazo de Costas sea estable'
    gain: '1.0'
    max_gain: '100'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 1e-3
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1380
    - 300.0
    rotation: 0
    state: enabled
- name: costas
  id: digital_costas_loop_cc
  parameters:
    comment: 'Lazo de Costas orden 2 (BPSK): fase residual. Ambiguedad de 180 grados'
    w: costas_bw
    order: '2'
    use_snr: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1560
    - 300.0
    rotation: 0
    state: enabled
- name: decisor_bpsk
  id: digital_constellation_decoder_cb
  parameters:
    comment: 'Decision BPSK: -1 -> bit 0, +1 -> bit 1 (mismo mapeo del Tx)'
    constellation: const_bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1760
    - 300.0
    rotation: 0
    state: enabled
- name: hz_por_rad
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: rad/muestra -> Hz
    const: samp_rate/(2*math.pi)
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
